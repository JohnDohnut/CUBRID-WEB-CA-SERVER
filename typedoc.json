{
  "entryPoints": [
    "src/index.ts"
  ],
  "out": "docs",
  "name": "WebCA Server API Documentation",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "readme": "README.md",
  "theme": "default",
  "sort": ["source-order"],
  "categorizeByGroup": false,
  "defaultCategory": "Other",
  "categoryOrder": [
    "Business Services",
    "Infrastructure Services", 
    "Controllers",
    "Decorators",
    "Types",
    "DTOs",
    "Errors",
    "Requests",
    "Responses",
    "Utilities",
    "Modules"
  ],
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "searchInComments": true,
  "cleanOutputDir": true,
  "plugin": [],
  "tsconfig": "tsconfig.json",
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "dist/**/*",
    "node_modules/**/*",
    "src/error/global-filter.ts"
  ],
  "groupOrder": [
    "Business Services",
    "Infrastructure Services",
    "Controllers",
    "Decorators",
    "Utilities",
    "Types",
    "DTOs",
    "Errors",
    "Modules"
  ]
}
