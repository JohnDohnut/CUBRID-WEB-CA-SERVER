{
  "name": "webca-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "bin": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "dev:port": "nest start --watch -- --SEED=seed --SALT=salt --PORT=8081",
    "dev:no-port": "nest start --watch -- --SEED=seed --SALT=salt",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:prod:seed": "node dist/main --SEED=seed --SALT=salt",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "pkg:win": "pkg . --targets node18-win-x64 --output dist/webca-server-win.exe",
    "pkg:linux": "pkg . --targets node18-linux-x64 --output dist/webca-server-linux",
    "pkg:all": "pkg . --targets node18-win-x64,node18-linux-x64 --output dist/webca-server",
    "docs": "typedoc",
    "docs:build": "typedoc --out docs",
    "docs:serve": "typedoc --out docs --watch --serve --port 7777",
    "docs:docx": "node convert-to-docx.js"
  },
  "pkg": {
    "scripts": [
      "dist/**/*.js",
      "node_modules/axios/**/*.js"
    ],
    "assets": [
      "ssl/**/*",
      "node_modules/axios/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-linux-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@types/uuid": "^10.0.0",
    "axios": "^1.4.0",
    "bcryptjs": "^3.0.2",
    "module-alias": "^2.2.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "proper-lockfile": "^4.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "selfsigned": "^3.0.1",
    "tsuml2": "^0.17.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "docx": "^9.5.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "markdown-docx": "^1.4.3",
    "marked": "^17.0.1",
    "pkg": "^5.8.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.28.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "_moduleAliases": {
    "@auth": "src/auth/index",
    "@broker": "src/broker/index",
    "@common": "src/common/index",
    "@config": "src/config",
    "@cms": "src/cms/index",
    "@cms-auth": "src/cms-auth",
    "@cms-config": "src/cms-config",
    "@cms-https-client": "src/cms-https-client",
    "@database": "src/database",
    "@decorators": "src/common/decorators",
    "@error": "src/error",
    "@extern_storage": "storage",
    "@file": "src/file",
    "@host": "src/host/index",
    "@lock": "src/lock/index",
    "@monitoring": "src/monitoring/index",
    "@repository": "src/repository/index",
    "@root": ".",
    "@security": "src/security/index",
    "@ssl": "ssl",
    "@src": "src",
    "@storage": "src/storage/index",
    "@token": "src/token/index",
    "@type": "src/type",
    "@user": "src/user/index",
    "@util": "src/util/index"
  }
}
