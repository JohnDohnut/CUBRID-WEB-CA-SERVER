{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@auth/*": ["src/auth/*"],
      "@broker/*": ["src/broker/*"],
      "@common/*": ["src/common/*"],
      "@config/*": ["src/config/*"],
      "@decorators/*": ["src/common/decorators/*"],
      "@error/*": ["src/error/*"],
      "@extern_storage/*": ["storage/*"],
      "@host/*": ["src/host/*"],
      "@lock/*": ["src/lock/*"],
      "@monitoring/*": ["src/monitoring/*"],
      "@repository/*": ["src/repository/*"],
      "@root/*": ["./*"],
      "@security/*": ["src/security/*"],
      "@ssl/*": ["ssl/*"],
      "@src/*": ["src/*"],
      "@storage/*": ["src/storage/*"],
      "@token/*": ["src/token/*"],
      "@type/*": ["src/type/*"],
      "@user/*": ["src/user/*"],
      "@util/*": ["src/util/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
