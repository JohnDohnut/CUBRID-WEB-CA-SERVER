{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@auth": ["src/auth/index"],
      "@auth/*": ["src/auth/*"],
      "@broker": ["src/broker/index"],
      "@broker/*": ["src/broker/*"],
      "@common": ["src/common/index"],
      "@common/*": ["src/common/*"],
      "@config/*": ["src/config/*"],
      "@cms": ["src/cms/index"],
      "@cms/*": ["src/cms/*"],
      "@cms-auth": ["src/cms-auth"],
      "@cms-auth/*": ["src/cms-auth/*"],
      "@cms-config": ["src/cms-config"],
      "@cms-config/*": ["src/cms-config/*"],
      "@cms-https-client": ["src/cms-https-client"],
      "@cms-https-client/*": ["src/cms-https-client/*"],
      "@database": ["src/database"],
      "@database/*": ["src/database/*"],
      "@decorators/*": ["src/common/decorators/*"],
      "@error": ["src/error/index"],
      "@error/*": ["src/error/*"],
      "@extern_storage/*": ["storage/*"],
      "@file": ["src/file"],
      "@file/*": ["src/file/*"],
      "@host": ["src/host/index"],
      "@host/*": ["src/host/*"],
      "@lock": ["src/lock/index"],
      "@lock/*": ["src/lock/*"],
      "@monitoring": ["src/monitoring/index"],
      "@monitoring/*": ["src/monitoring/*"],
      "@repository": ["src/repository/index"],
      "@repository/*": ["src/repository/*"],
      "@root/*": ["./*"],
      "@security": ["src/security/index"],
      "@security/*": ["src/security/*"],
      "@ssl/*": ["ssl/*"],
      "@src/*": ["src/*"],
      "@storage": ["src/storage/index"],
      "@storage/*": ["src/storage/*"],
      "@token": ["src/token/index"],
      "@token/*": ["src/token/*"],
      "@type": ["src/type/index"],
      "@type/*": ["src/type/*"],
      "@user": ["src/user/index"],
      "@user/*": ["src/user/*"],
      "@util": ["src/util/index"],
      "@util/*": ["src/util/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
